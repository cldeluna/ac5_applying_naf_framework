# InfraHub API Configuration
# Copy this file to .env and fill in your actual token

INFRAHUB_URL=https://sandbox.infrahub.app/graphql
INFRAHUB_TOKEN=your_token_here

# Network Devices
NET_DEVICE_USERNAME=your_username_here
NET_DEVICE_PASSWORD=your_password_here
NET_DEVICE_SECRET=your_secret_here

# ContainerLab validation node (Step 7)
CLAB_HOST=192.0.2.1
CLAB_PORT=22
CLAB_USER=admin
CLAB_PASSWORD=your_clab_password_here