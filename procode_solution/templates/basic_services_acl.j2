ip access-list extended BASIC_DATA_SRVC_IN
  remark === Basic Services Inbound Policy — generated by update_basic_srvs_pol.py ===
  remark --- Web Services (HTTP/HTTPS) ---
{% for host in web_servers %}
  permit tcp any host {{ host.address }} eq 80
  permit tcp any host {{ host.address }} eq 443
{% endfor %}
  remark --- DNS inbound (UDP/TCP port 53) ---
{% for host in dns_servers %}
  permit udp any host {{ host.address }} eq domain
  permit tcp any host {{ host.address }} eq domain
{% endfor %}
  remark --- DHCP client broadcast (DISCOVER/REQUEST before ip helper-address relay) ---
  permit udp any host 255.255.255.255 eq bootps
  remark --- DHCP inbound unicast to DHCP servers (renewals) ---
{% for host in dhcp_servers %}
  permit udp any host {{ host.address }} eq bootps
{% endfor %}
  remark --- Explicit deny ---
  deny   ip any any log
!
ip access-list extended BASIC_DATA_SRVC_OUT
  remark === Basic Services Outbound Policy — generated by update_basic_srvs_pol.py ===
  remark --- DNS outbound (from DNS servers) ---
{% for host in dns_servers %}
  permit udp host {{ host.address }} any eq domain
  permit tcp host {{ host.address }} any eq domain
{% endfor %}
  remark --- DHCP outbound (from DHCP servers) ---
{% for host in dhcp_servers %}
  permit udp host {{ host.address }} eq bootps any eq bootpc
{% endfor %}
  remark --- Default permit ---
  permit ip any any
